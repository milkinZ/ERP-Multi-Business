{
  "title": "ERP API Overview",
  "panels": [
    {
      "type": "graph",
      "title": "HTTP Requests (rate)",
      "targets": [
        { "expr": "rate(http_requests_total[1m])", "legendFormat": "{{method}} {{route}}" }
      ]
    },
    {
      "type": "graph",
      "title": "HTTP Latency (p95)",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "graph",
      "title": "Websocket Connections",
      "targets": [
        { "expr": "sum(websocket_connections) by (tenant)", "legendFormat": "{{tenant}}" }
      ]
    },
    {
      "type": "graph",
      "title": "Queue Waiting",
      "targets": [
        { "expr": "sum(queue_jobs_waiting) by (queue)", "legendFormat": "{{queue}}" }
      ]
    }
  ]
}
