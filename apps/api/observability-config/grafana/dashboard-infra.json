{
  "dashboard": {
    "id": null,
    "title": "ERP API - Infrastructure",
    "panels": [
      {
        "type": "graph",
        "title": "HTTP Requests (RPS)",
        "targets": [
          { "expr": "sum(rate(http_requests_total[1m])) by (route)", "legendFormat": "{{route}}" }
        ]
      },
      {
        "type": "graph",
        "title": "HTTP 95th Latency",
        "targets": [
          { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "95th" }
        ]
      },
      {
        "type": "graph",
        "title": "Queue Waiting",
        "targets": [
          { "expr": "sum(queue_jobs_waiting) by (queue)", "legendFormat": "{{queue}}" }
        ]
      }
    ]
  },
  "overwrite": false
}
