generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  id                             String                           @id @default(cuid())
  code                           String
  name                           String
  description                    String?
  unit                           String?
  type                           InventoryItemType
  isActive                       Boolean                          @default(true)
  valuationMethod                InventoryValuationMethod?
  movingAverageScope             MovingAverageScope?
  standardCost                   Decimal?                         @db.Decimal(18, 6)
  averageUnitCost                Decimal?                         @db.Decimal(18, 6)
  valuationLockedAt              DateTime?
  tenantId                       String
  createdAt                      DateTime                         @default(now())
  Tenant                         Tenant                           @relation(fields: [tenantId], references: [id])
  InventoryMovement              InventoryMovement[]
  InventoryCostLayer             InventoryCostLayer[]
  InventoryStock                 InventoryStock[]
  Product                        Product?
  PurchaseOrderItem              PurchaseOrderItem[]
  SupplierItemOffer              SupplierItemOffer[]
  PurchaseOrderReceiptItem       PurchaseOrderReceiptItem[]
  PurchaseOrderReturnItem        PurchaseOrderReturnItem[]
  InventoryPurchasePriceVariance InventoryPurchasePriceVariance[]
  WarehouseTransferItem          WarehouseTransferItem[]
  WarehouseTransferReceiptItem   WarehouseTransferReceiptItem[]
  RecipeItem                     RecipeItem[]
  InventoryReorderRule           InventoryReorderRule[]
  UnitConversionHistory          InventoryUnitConversion[]
  RecipeSnapshotItems            SalesOrderRecipeSnapshotItem[]
  taxCategory                    String?                          @map("TaxCategory")

  @@unique([tenantId, code])
  @@index([tenantId, createdAt, id])
}

model InventoryMovement {
  id                       String                            @id @default(cuid())
  tenantId                 String
  type                     InventoryMovementType
  quantity                 Float
  unit                     String?
  note                     String?
  createdAt                DateTime                          @default(now())
  afterQuantity            Float?
  beforeQuantity           Float?
  createdById              String?
  inventoryItemId          String
  referenceId              String?
  referenceType            String?
  warehouseId              String?
  unitCost                 Decimal?                          @db.Decimal(18, 6)
  totalCost                Decimal?                          @db.Decimal(18, 6)
  User                     User?                             @relation(fields: [createdById], references: [id])
  InventoryItem            InventoryItem                     @relation(fields: [inventoryItemId], references: [id])
  Tenant                   Tenant                            @relation(fields: [tenantId], references: [id])
  Warehouse                Warehouse?                        @relation(fields: [warehouseId], references: [id])
  CostAllocations          InventoryMovementCostAllocation[]
  CostLayers               InventoryCostLayer[]
  PurchaseOrderReceiptItem PurchaseOrderReceiptItem?

  @@index([inventoryItemId])
  @@index([referenceType, referenceId])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, warehouseId, createdAt, id])
  @@index([tenantId, inventoryItemId, createdAt, id])
}

model InventoryStock {
  id              String        @id @default(cuid())
  warehouseId     String?
  inventoryItemId String
  quantity        Float         @default(0)
  averageUnitCost Decimal?      @db.Decimal(18, 6)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  InventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  Warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([warehouseId])
}

model InventoryReorderRule {
  id                 String                           @id @default(cuid())
  tenantId           String
  inventoryItemId    String
  warehouseId        String?
  locationKey        String
  scope              InventoryReorderScope
  quantityStrategy   InventoryReorderQuantityStrategy
  action             InventoryReorderAction           @default(ALERT_AND_SUGGEST)
  reorderPoint       Float
  targetStock        Float?
  fixedOrderQuantity Float?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  Tenant             Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  InventoryItem      InventoryItem                    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  Warehouse          Warehouse?                       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, inventoryItemId, locationKey])
  @@index([tenantId, inventoryItemId])
}

model InventoryCostLayer {
  id                String                            @id @default(cuid())
  tenantId          String
  inventoryItemId   String
  warehouseId       String?
  sourceMovementId  String?
  sourceType        String
  sourceReferenceId String?
  receivedQuantity  Decimal                           @db.Decimal(18, 6)
  remainingQuantity Decimal                           @db.Decimal(18, 6)
  unitCost          Decimal                           @db.Decimal(18, 6)
  unit              String?
  createdAt         DateTime                          @default(now())
  InventoryItem     InventoryItem                     @relation(fields: [inventoryItemId], references: [id])
  Warehouse         Warehouse?                        @relation(fields: [warehouseId], references: [id])
  SourceMovement    InventoryMovement?                @relation(fields: [sourceMovementId], references: [id], onDelete: SetNull)
  CostAllocations   InventoryMovementCostAllocation[]

  @@index([tenantId, inventoryItemId, warehouseId, createdAt, id], map: "InventoryCostLayer_tenantId_inventoryItemId_warehouseId_created")
  @@index([sourceType, sourceReferenceId])
}

model InventoryMovementCostAllocation {
  id          String              @id @default(cuid())
  movementId  String
  costLayerId String?
  quantity    Decimal             @db.Decimal(18, 6)
  unitCost    Decimal             @db.Decimal(18, 6)
  unit        String?
  Movement    InventoryMovement   @relation(fields: [movementId], references: [id], onDelete: Cascade)
  CostLayer   InventoryCostLayer? @relation(fields: [costLayerId], references: [id], onDelete: SetNull)

  @@index([movementId])
  @@index([costLayerId])
}

model Outlet {
  id                       String                   @id @default(cuid())
  name                     String
  tenantId                 String
  createdAt                DateTime                 @default(now())
  deletedAt                DateTime?
  updatedAt                DateTime                 @updatedAt
  AuditLog                 AuditLog[]
  Notification             Notification[]
  NotificationPreference   NotificationPreference[]
  Tenant                   Tenant                   @relation(fields: [tenantId], references: [id])
  SalesOrder               SalesOrder[]
  KitchenStations          KitchenStation[]
  KitchenStationCategories KitchenStationCategory[]
  Session                  Session[]
  UserOutlet               UserOutlet[]
  UserInvitationOutlet     UserInvitationOutlet[]
  Warehouse                Warehouse[]
}

model Payment {
  id                       String        @id @default(cuid())
  orderId                  String
  tenantId                 String
  method                   PaymentMethod
  status                   PaymentStatus @default(PENDING)
  amount                   Int
  referenceNumber          String?
  providerReferenceId      String?       @unique
  providerPaymentRequestId String?       @unique
  providerPaymentId        String?       @unique
  providerEventId          String?       @unique
  providerStatus           String?
  paidAt                   DateTime?
  createdAt                DateTime      @default(now())
  createdById              String?
  User                     User?         @relation(fields: [createdById], references: [id])
  SalesOrder               SalesOrder    @relation(fields: [orderId], references: [id])
  Tenant                   Tenant        @relation(fields: [tenantId], references: [id])
}

model Permission {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  RolePermission RolePermission[]
}

model Product {
  id                     String           @id @default(cuid())
  name                   String
  description            String?
  sku                    String?
  stockMode              ProductStockMode @default(UNTRACKED)
  kitchenCategory        String?          @db.VarChar(64)
  kitchenPrepTimeMinutes Int?
  price                  Int
  isActive               Boolean          @default(true)
  tenantId               String
  createdAt              DateTime         @default(now())
  outletId               String?
  inventoryItemId        String?          @unique
  InventoryItem          InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  Tenant                 Tenant           @relation(fields: [tenantId], references: [id])
  Recipe                 Recipe?
  SalesOrderItem         SalesOrderItem[]

  @@unique([tenantId, sku])
}

model PurchaseOrder {
  id                             String                           @id @default(cuid())
  poNumber                       String                           @db.VarChar(50)
  status                         PurchaseOrderStatus              @default(DRAFT)
  supplierId                     String
  tenantId                       String
  warehouseId                    String?
  expectedDeliveryDate           DateTime?
  totalAmount                    Int
  currencyCode                   String?                          @db.Char(3)
  notes                          String?
  receivedAt                     DateTime?
  completedAt                    DateTime?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime
  Supplier                       Supplier                         @relation(fields: [supplierId], references: [id])
  Tenant                         Tenant                           @relation(fields: [tenantId], references: [id])
  Warehouse                      Warehouse?                       @relation(fields: [warehouseId], references: [id])
  PurchaseOrderItem              PurchaseOrderItem[]
  PurchaseOrderReceipt           PurchaseOrderReceipt[]
  PurchaseOrderReturn            PurchaseOrderReturn[]
  InventoryPurchasePriceVariance InventoryPurchasePriceVariance[]

  @@unique([tenantId, poNumber])
  @@index([status])
  @@index([supplierId])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id                             String                           @id @default(cuid())
  purchaseOrderId                String
  inventoryItemId                String
  quantity                       Float
  unit                           String?
  unitPrice                      Decimal                          @db.Decimal(18, 6)
  subtotal                       Int
  receivedQuantity               Float                            @default(0)
  InventoryItem                  InventoryItem                    @relation(fields: [inventoryItemId], references: [id])
  PurchaseOrder                  PurchaseOrder                    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ReceiptItem                    PurchaseOrderReceiptItem[]
  ReturnItem                     PurchaseOrderReturnItem[]
  InventoryPurchasePriceVariance InventoryPurchasePriceVariance[]

  @@index([inventoryItemId])
  @@index([purchaseOrderId])
}

model PurchaseOrderReceipt {
  id                             String                           @id @default(cuid())
  tenantId                       String
  purchaseOrderId                String
  createdById                    String?
  idempotencyKey                 String                           @db.VarChar(128)
  requestHash                    String                           @db.VarChar(64)
  statusAfter                    PurchaseOrderStatus
  note                           String?
  createdAt                      DateTime                         @default(now())
  Items                          PurchaseOrderReceiptItem[]
  PurchaseOrder                  PurchaseOrder                    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  Tenant                         Tenant                           @relation(fields: [tenantId], references: [id])
  User                           User?                            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  InventoryPurchasePriceVariance InventoryPurchasePriceVariance[]

  @@unique([purchaseOrderId, idempotencyKey])
  @@index([tenantId, purchaseOrderId, createdAt])
}

model PurchaseOrderReceiptItem {
  id                             String                          @id @default(cuid())
  tenantId                       String
  receiptId                      String
  purchaseOrderItemId            String
  inventoryItemId                String
  receivedQuantity               Float
  movementId                     String?                         @unique
  unit                           String?
  Receipt                        PurchaseOrderReceipt            @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  PurchaseOrderItem              PurchaseOrderItem               @relation(fields: [purchaseOrderItemId], references: [id])
  InventoryItem                  InventoryItem                   @relation(fields: [inventoryItemId], references: [id])
  Tenant                         Tenant                          @relation(fields: [tenantId], references: [id])
  InventoryPurchasePriceVariance InventoryPurchasePriceVariance?
  ReturnItems                    PurchaseOrderReturnItem[]
  InvoiceLines                   SupplierInvoiceLine[]
  CreditNoteLines                SupplierCreditNoteLine[]
  Movement                       InventoryMovement?              @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@unique([receiptId, purchaseOrderItemId])
  @@index([tenantId, receiptId])
  @@index([purchaseOrderItemId])
}

model PurchaseOrderReturn {
  id              String                    @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  createdById     String?
  idempotencyKey  String                    @db.VarChar(128)
  requestHash     String                    @db.VarChar(64)
  note            String?
  creditAmount    Decimal                   @db.Decimal(18, 6)
  currencyCode    String?                   @db.Char(3)
  createdAt       DateTime                  @default(now())
  Items           PurchaseOrderReturnItem[]
  PurchaseOrder   PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  Tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  User            User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  CreditNotes     SupplierCreditNote[]

  @@unique([purchaseOrderId, idempotencyKey])
  @@index([tenantId, purchaseOrderId, createdAt])
}

model PurchaseOrderReturnItem {
  id                   String                    @id @default(cuid())
  tenantId             String
  returnId             String
  purchaseOrderItemId  String
  inventoryItemId      String
  quantity             Float
  unit                 String?
  unitPrice            Decimal                   @db.Decimal(18, 6)
  creditAmount         Decimal                   @db.Decimal(18, 6)
  receiptItemId        String?
  inventoryCost        Decimal?                  @db.Decimal(18, 6)
  invoicedQuantity     Decimal                   @default(0) @db.Decimal(18, 6)
  invoicedCreditAmount Decimal                   @default(0) @db.Decimal(18, 6)
  Return               PurchaseOrderReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  PurchaseOrderItem    PurchaseOrderItem         @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  ReceiptItem          PurchaseOrderReceiptItem? @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)
  InventoryItem        InventoryItem             @relation(fields: [inventoryItemId], references: [id])
  Tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  CreditNoteLines      SupplierCreditNoteLine[]

  @@index([tenantId, returnId])
  @@index([purchaseOrderItemId])
  @@index([receiptItemId])
}

model AccountingSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  invoiceApprovalRequired Boolean  @default(true)
  autoPostMatchedInvoices Boolean  @default(false)
  updatedAt               DateTime @updatedAt
  Tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AccountingAccount {
  id           String                     @id @default(cuid())
  tenantId     String
  code         String                     @db.VarChar(32)
  name         String                     @db.VarChar(120)
  type         AccountingAccountType
  isActive     Boolean                    @default(true)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  Tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Mappings     AccountingAccountMapping[]
  JournalLines JournalEntryLine[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, code])
}

model AccountingAccountMapping {
  id        String                @id @default(cuid())
  tenantId  String
  role      AccountingAccountRole
  accountId String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  Tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Account   AccountingAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, role])
  @@index([tenantId, accountId])
}

model AccountingPeriod {
  id        String                 @id @default(cuid())
  tenantId  String
  name      String                 @db.VarChar(80)
  startsAt  DateTime               @db.Date
  endsAt    DateTime               @db.Date
  status    AccountingPeriodStatus @default(OPEN)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  Tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Journals  JournalEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, status, startsAt, endsAt])
}

model JournalEntry {
  id           String             @id @default(cuid())
  tenantId     String
  periodId     String
  number       String             @db.VarChar(40)
  sourceType   String             @db.VarChar(48)
  sourceId     String             @db.VarChar(191)
  currencyCode String             @db.Char(3)
  entryDate    DateTime           @db.Date
  memo         String             @db.VarChar(500)
  status       JournalEntryStatus @default(POSTED)
  createdById  String?
  createdAt    DateTime           @default(now())
  postedAt     DateTime           @default(now())
  Tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  Period       AccountingPeriod   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  Lines        JournalEntryLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, entryDate, id])
  @@index([tenantId, periodId, status])
}

model JournalEntryLine {
  id             String            @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountId      String
  description    String?           @db.VarChar(240)
  debit          Decimal           @default(0) @db.Decimal(18, 6)
  credit         Decimal           @default(0) @db.Decimal(18, 6)
  createdAt      DateTime          @default(now())
  Tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  Journal        JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  Account        AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, journalEntryId])
  @@index([tenantId, accountId])
}

model TaxRule {
  id                String             @id @default(cuid())
  tenantId          String
  code              String             @db.VarChar(40)
  name              String             @db.VarChar(120)
  kind              TaxRuleKind
  transactionType   String             @db.VarChar(48)
  taxCategory       String?            @db.VarChar(64)
  supplierTaxStatus String?            @db.VarChar(64)
  jurisdiction      String?            @db.VarChar(64)
  rate              Decimal            @db.Decimal(12, 8)
  withholdingTiming WithholdingTiming?
  effectiveFrom     DateTime           @db.Date
  effectiveTo       DateTime?          @db.Date
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  Tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, kind, transactionType, effectiveFrom, effectiveTo])
}

model SupplierInvoice {
  id                  String                      @id @default(cuid())
  tenantId            String
  supplierId          String
  invoiceNumber       String                      @db.VarChar(80)
  currencyCode        String                      @db.Char(3)
  invoiceDate         DateTime                    @db.Date
  dueDate             DateTime?                   @db.Date
  status              SupplierInvoiceStatus       @default(DRAFT)
  matchStatus         SupplierInvoiceMatchStatus  @default(MATCHED)
  subtotal            Decimal                     @db.Decimal(18, 6)
  inputTaxAmount      Decimal                     @default(0) @db.Decimal(18, 6)
  withholdingAmount   Decimal                     @default(0) @db.Decimal(18, 6)
  grossAmount         Decimal                     @db.Decimal(18, 6)
  netPayableAmount    Decimal                     @db.Decimal(18, 6)
  withholdingTiming   WithholdingTiming?
  taxSnapshot         Json?
  withholdingSnapshot Json?
  matchExceptions     Json?
  idempotencyKey      String                      @db.VarChar(128)
  requestHash         String                      @db.VarChar(64)
  createdById         String?
  approvedById        String?
  approvedAt          DateTime?
  postedAt            DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  Tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  Supplier            Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  Lines               SupplierInvoiceLine[]
  CreditNotes         SupplierCreditNote[]
  PaymentAllocations  SupplierPaymentAllocation[]

  @@unique([tenantId, supplierId, invoiceNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, invoiceDate, id])
  @@index([tenantId, supplierId, status])
}

model SupplierInvoiceLine {
  id                String                   @id @default(cuid())
  tenantId          String
  invoiceId         String
  receiptItemId     String
  quantity          Decimal                  @db.Decimal(18, 6)
  unitPrice         Decimal                  @db.Decimal(18, 6)
  matchedUnitPrice  Decimal                  @db.Decimal(18, 6)
  subtotal          Decimal                  @db.Decimal(18, 6)
  inputTaxAmount    Decimal                  @default(0) @db.Decimal(18, 6)
  withholdingAmount Decimal                  @default(0) @db.Decimal(18, 6)
  taxCategory       String?                  @db.VarChar(64)
  taxSnapshot       Json?
  createdAt         DateTime                 @default(now())
  Tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  Invoice           SupplierInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  ReceiptItem       PurchaseOrderReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)
  CreditNoteLines   SupplierCreditNoteLine[]

  @@unique([invoiceId, receiptItemId])
  @@index([tenantId, receiptItemId])
}

model SupplierCreditNote {
  id                    String                   @id @default(cuid())
  tenantId              String
  supplierId            String
  invoiceId             String?
  purchaseOrderReturnId String?
  creditNumber          String                   @db.VarChar(80)
  type                  SupplierCreditNoteType
  status                SupplierCreditNoteStatus @default(PENDING_APPROVAL)
  reason                String                   @db.VarChar(500)
  claimReference        String?                  @db.VarChar(120)
  currencyCode          String                   @db.Char(3)
  subtotal              Decimal                  @db.Decimal(18, 6)
  inputTaxAdjustment    Decimal                  @default(0) @db.Decimal(18, 6)
  withholdingAdjustment Decimal                  @default(0) @db.Decimal(18, 6)
  grossAmount           Decimal                  @db.Decimal(18, 6)
  taxSnapshot           Json?
  idempotencyKey        String                   @db.VarChar(128)
  requestHash           String                   @db.VarChar(64)
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  postedAt              DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  Tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  Supplier              Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  Invoice               SupplierInvoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  PurchaseOrderReturn   PurchaseOrderReturn?     @relation(fields: [purchaseOrderReturnId], references: [id], onDelete: Restrict)
  Lines                 SupplierCreditNoteLine[]

  @@unique([tenantId, supplierId, creditNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt, id])
  @@index([tenantId, purchaseOrderReturnId])
  @@index([tenantId, invoiceId])
}

model SupplierCreditNoteLine {
  id                    String                    @id @default(cuid())
  tenantId              String
  creditNoteId          String
  invoiceLineId         String?
  receiptItemId         String?
  returnItemId          String?
  allocationType        CreditAllocationType
  quantity              Decimal?                  @db.Decimal(18, 6)
  amount                Decimal                   @db.Decimal(18, 6)
  inputTaxAdjustment    Decimal                   @default(0) @db.Decimal(18, 6)
  withholdingAdjustment Decimal                   @default(0) @db.Decimal(18, 6)
  reason                String?                   @db.VarChar(240)
  taxSnapshot           Json?
  createdAt             DateTime                  @default(now())
  Tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  CreditNote            SupplierCreditNote        @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  InvoiceLine           SupplierInvoiceLine?      @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  ReceiptItem           PurchaseOrderReceiptItem? @relation(fields: [receiptItemId], references: [id], onDelete: Restrict)
  ReturnItem            PurchaseOrderReturnItem?  @relation(fields: [returnItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, creditNoteId])
  @@index([tenantId, receiptItemId])
}

model SupplierPayment {
  id             String                      @id @default(cuid())
  tenantId       String
  supplierId     String
  paymentDate    DateTime                    @db.Date
  currencyCode   String                      @db.Char(3)
  method         SupplierPaymentMethod
  reference      String?                     @db.VarChar(120)
  amount         Decimal                     @db.Decimal(18, 6)
  idempotencyKey String                      @db.VarChar(128)
  requestHash    String                      @db.VarChar(64)
  createdById    String?
  createdAt      DateTime                    @default(now())
  Tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  Supplier       Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  Allocations    SupplierPaymentAllocation[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, supplierId, paymentDate, id])
}

model SupplierPaymentAllocation {
  id                String          @id @default(cuid())
  tenantId          String
  paymentId         String
  invoiceId         String
  allocatedAmount   Decimal         @db.Decimal(18, 6)
  withholdingAmount Decimal         @default(0) @db.Decimal(18, 6)
  netAmount         Decimal         @db.Decimal(18, 6)
  createdAt         DateTime        @default(now())
  Tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  Payment           SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  Invoice           SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([tenantId, invoiceId])
}

model InventoryPurchasePriceVariance {
