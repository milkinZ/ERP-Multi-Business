generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ingredient {
  id              String        @id @default(cuid())
  name            String
  unit            String
  tenantId        String
  createdAt       DateTime      @default(now())
  inventoryItemId String        @unique
  InventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  Tenant          Tenant        @relation(fields: [tenantId], references: [id])
  RecipeItem      RecipeItem[]
}

model InventoryItem {
  id                String              @id @default(cuid())
  code              String
  name              String
  description       String?
  unit              String?
  type              InventoryItemType
  isActive          Boolean             @default(true)
  tenantId          String
  createdAt         DateTime            @default(now())
  Ingredient        Ingredient?
  Tenant            Tenant              @relation(fields: [tenantId], references: [id])
  InventoryMovement InventoryMovement[]
  InventoryStock    InventoryStock[]
  Product           Product?
  PurchaseOrderItem PurchaseOrderItem[]

  @@unique([tenantId, code])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  tenantId        String
  type            InventoryMovementType
  quantity        Float
  note            String?
  createdAt       DateTime              @default(now())
  afterQuantity   Float?
  beforeQuantity  Float?
  createdById     String?
  inventoryItemId String
  referenceId     String?
  referenceType   String?
  warehouseId     String?
  User            User?                 @relation(fields: [createdById], references: [id])
  InventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  Tenant          Tenant                @relation(fields: [tenantId], references: [id])
  Warehouse       Warehouse?            @relation(fields: [warehouseId], references: [id])

  @@index([inventoryItemId])
  @@index([referenceType, referenceId])
  @@index([tenantId])
  @@index([warehouseId])
}

model InventoryStock {
  id              String        @id @default(cuid())
  warehouseId     String?
  inventoryItemId String
  quantity        Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  InventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  Warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([warehouseId])
}

model Outlet {
  id           String         @id @default(cuid())
  name         String
  tenantId     String
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime       @updatedAt
  AuditLog     AuditLog[]
  Notification Notification[]
  Tenant       Tenant         @relation(fields: [tenantId], references: [id])
  SalesOrder   SalesOrder[]
  Session      Session[]
  UserOutlet   UserOutlet[]
  Warehouse    Warehouse[]
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  tenantId        String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Int
  referenceNumber String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  createdById     String?
  User            User?         @relation(fields: [createdById], references: [id])
  SalesOrder      SalesOrder    @relation(fields: [orderId], references: [id])
  Tenant          Tenant        @relation(fields: [tenantId], references: [id])
}

model Permission {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  RolePermission RolePermission[]
}

model Product {
  id              String           @id @default(cuid())
  name            String
  description     String?
  sku             String?
  price           Int
  isActive        Boolean          @default(true)
  tenantId        String
  createdAt       DateTime         @default(now())
  outletId        String?
  inventoryItemId String?          @unique
  InventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  Tenant          Tenant           @relation(fields: [tenantId], references: [id])
  Recipe          Recipe?
  SalesOrderItem  SalesOrderItem[]

  @@unique([tenantId, sku])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String              @db.VarChar(50)
  status               PurchaseOrderStatus @default(DRAFT)
  supplierId           String
  tenantId             String
  warehouseId          String?
  expectedDeliveryDate DateTime?
  totalAmount          Int
  notes                String?
  receivedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  Supplier             Supplier            @relation(fields: [supplierId], references: [id])
  Tenant               Tenant              @relation(fields: [tenantId], references: [id])
  Warehouse            Warehouse?          @relation(fields: [warehouseId], references: [id])
  PurchaseOrderItem    PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([status])
  @@index([supplierId])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantity         Float
  unitPrice        Int
  subtotal         Int
  receivedQuantity Float         @default(0)
  InventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  PurchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([purchaseOrderId])
}

model Recipe {
  id         String       @id @default(cuid())
  tenantId   String
  productId  String       @unique
  createdAt  DateTime     @default(now())
  Product    Product      @relation(fields: [productId], references: [id])
  Tenant     Tenant       @relation(fields: [tenantId], references: [id])
  RecipeItem RecipeItem[]
}

model RecipeItem {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  Ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  Recipe       Recipe     @relation(fields: [recipeId], references: [id])
}

model RefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  tenantId      String
  roleId        String
  outletId      String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  rotatedFromId String?
  tokenSelector String    @unique
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id             String           @id @default(cuid())
  name           String
  tenantId       String
  Tenant         Tenant           @relation(fields: [tenantId], references: [id])
  RolePermission RolePermission[]
  UserRole       UserRole[]
}

model RolePermission {
  id           String     @id
  roleId       String
  permissionId String
  Permission   Permission @relation(fields: [permissionId], references: [id])
  Role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model SalesOrder {
  id             String           @id @default(cuid())
  orderNumber    String           @db.VarChar(50)
  status         OrderStatus      @default(PENDING)
  totalAmount    Int
  tenantId       String
  outletId       String?
  createdAt      DateTime         @default(now())
  Payment        Payment[]
  Outlet         Outlet?          @relation(fields: [outletId], references: [id])
  Tenant         Tenant           @relation(fields: [tenantId], references: [id])
  SalesOrderItem SalesOrderItem[]

  @@unique([tenantId, orderNumber])
}

model SalesOrderItem {
  id         String     @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  price      Int
  subtotal   Int
  SalesOrder SalesOrder @relation(fields: [orderId], references: [id])
  Product    Product    @relation(fields: [productId], references: [id])
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  tenantId      String
  createdAt     DateTime        @default(now())
  contactPerson String?
  isActive      Boolean         @default(true)
  taxNumber     String?
  PurchaseOrder PurchaseOrder[]
  Tenant        Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model Tenant {
  id                String              @id @default(cuid())
  name              String
  createdAt         DateTime            @default(now())
  businessType      BusinessType        @default(CAFE)
  deletedAt         DateTime?
  updatedAt         DateTime            @updatedAt
  AuditLog          AuditLog[]
  FeatureFlag       FeatureFlag[]
  Ingredient        Ingredient[]
  InventoryItem     InventoryItem[]
  InventoryMovement InventoryMovement[]
  Invoice           Invoice[]
  Notification      Notification[]
  Outlet            Outlet[]
  Payment           Payment[]
  Product           Product[]
  PurchaseOrder     PurchaseOrder[]
  Recipe            Recipe[]
  Role              Role[]
  SalesOrder        SalesOrder[]
  Session           Session[]
  Subscription      Subscription?
  Supplier          Supplier[]
  User              User[]
  UserOutlet        UserOutlet[]
  UserRole          UserRole[]
  Warehouse         Warehouse[]
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  password          String
  tenantId          String
  createdAt         DateTime            @default(now())
  deletedAt         DateTime?
  updatedAt         DateTime            @updatedAt
  AuditLog          AuditLog[]
  InventoryMovement InventoryMovement[]
  Notification      Notification[]
  Payment           Payment[]
  RefreshToken      RefreshToken[]
  Session           Session[]
  Tenant            Tenant              @relation(fields: [tenantId], references: [id])
  UserOutlet        UserOutlet[]
  UserRole          UserRole[]
}

model Warehouse {
  id                String              @id @default(cuid())
  name              String
  tenantId          String
  outletId          String?
  createdAt         DateTime            @default(now())
  code              String
  InventoryMovement InventoryMovement[]
  InventoryStock    InventoryStock[]
  PurchaseOrder     PurchaseOrder[]
  Outlet            Outlet?             @relation(fields: [outletId], references: [id])
  Tenant            Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model OutboxEvent {
  id          String            @id @default(cuid())
  tenantId    String?
  outletId    String?
  type        String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  processedAt DateTime?
  deletedAt   DateTime?

  @@index([status])
  @@index([createdAt])
}

model DeadLetterJob {
  id           String              @id @default(cuid())
  queueName    String
  jobId        String
  tenantId     String?
  outletId     String?
  payload      Json
  errorMessage String
  stackTrace   String?
  attemptsMade Int                 @default(0)
  failedAt     DateTime            @default(now())
  retriedAt    DateTime?
  resolvedAt   DateTime?
  status       DeadLetterJobStatus @default(FAILED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([queueName, jobId])
  @@index([queueName])
  @@index([status])
  @@index([failedAt])
}

model Session {
  id        String    @id @default(cuid())
  sessionId String    @unique
  userId    String
  tenantId  String
  outletId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  outlet    Outlet?   @relation(fields: [outletId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  tenantId  String
  outletId  String?
  entity    String
  entityId  String
  action    String
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  outlet    Outlet?   @relation(fields: [outletId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
  @@index([action])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  outletId  String?
  userId    String?
  type      String
  title     String?
  message   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  outlet    Outlet?   @relation(fields: [outletId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([type])
}

model FeatureFlag {
  id        String    @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean   @default(false)
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Plan {
  id            String         @id @default(cuid())
  type          PlanType       @unique
  name          String
  priceCents    Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  Subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  plan      Plan               @relation(fields: [planId], references: [id])
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
}

model Invoice {
  id             String    @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNumber  String    @unique
  amountCents    Int
  currency       String    @default("IDR")
  status         String    @default("PENDING")
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
}

model UserOutlet {
  id        String    @id @default(cuid())
  userId    String
  outletId  String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([tenantId])
}

enum BusinessType {
  CAFE
  RETAIL
  LAUNDRY
  GYM
  HOTEL
  MANUFACTURING
}

enum InventoryItemType {
  PRODUCT
  INGREDIENT
  MATERIAL
  ASSET
  SUPPLY
  SERVICE
}

enum InventoryMovementType {
  STOCK_IN
  SALE
  WASTE
  ADJUSTMENT
  RETURN
  STOCK_OUT
  PURCHASE
  CONSUMPTION
  PRODUCTION
  TRANSFER
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  IN_PROGRESS
  READY
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum DeadLetterJobStatus {
  FAILED
  RETRYING
  RESOLVED
}

enum PlanType {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}
