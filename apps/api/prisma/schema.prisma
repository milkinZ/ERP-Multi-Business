  auditLogs           PlatformAuditLog[]
  subscriptionHistory SubscriptionHistory[]
  CreatedInvitations  UserInvitation[]      @relation("PlatformUserInvitationCreator")

  @@unique([issuer, subject])
  @@index([disabledAt, role])
}

model PlatformSession {
  id         String           @id @default(cuid())
  identityId String
  tokenHash  String           @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  identity   PlatformIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, revokedAt])
  @@index([expiresAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model OperationalEventLog {
  id         String   @id @default(cuid())
  level      String
  eventType  String
  method     String
  route      String
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([level, createdAt])
}

model OperationalMetricBucket {
  id              String   @id @default(cuid())
  bucketStart     DateTime
  method          String
  route           String
  statusClass     String
  requestCount    Int      @default(0)
  errorCount      Int      @default(0)
  durationTotalMs Int      @default(0)

  @@unique([bucketStart, method, route, statusClass])
  @@index([bucketStart])
}

model Notification {
  id            String    @id @default(cuid())
  tenantId      String
  outletId      String?
  userId        String?
  category      String?   @db.VarChar(32)
  sourceEventId String?   @db.VarChar(128)
  type          String
  title         String?
  message       String?
  payload       Json?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  outlet        Outlet?   @relation(fields: [outletId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, sourceEventId])
  @@index([tenantId])
  @@index([type])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  category  String   @db.VarChar(32)
  channel   String   @db.VarChar(16)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Outlet    Outlet?  @relation(fields: [outletId], references: [id])
  outletId  String?

  @@unique([tenantId, userId, category, channel])
  @@index([tenantId, userId])
}

model FeatureFlag {
  id        String    @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean   @default(false)
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Plan {
  id                   String              @id @default(cuid())
  type                 PlanType            @unique
  name                 String
  priceCents           Int
  maxOutlets           Int?
  maxUsers             Int?
  maxMonthlyOrders     Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  Subscriptions        Subscription[]      @relation("CurrentSubscriptionPlan")
  PendingSubscriptions Subscription[]      @relation("PendingSubscriptionPlan")
  modules              PlanFeatureModule[]
}

model Subscription {
  id            String                      @id @default(cuid())
  tenantId      String                      @unique
  planId        String
  pendingPlanId String?
  status        SubscriptionStatus          @default(ACTIVE)
  startedAt     DateTime                    @default(now())
  endedAt       DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  deletedAt     DateTime?
  plan          Plan                        @relation("CurrentSubscriptionPlan", fields: [planId], references: [id])
  pendingPlan   Plan?                       @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id], onDelete: Restrict)
  tenant        Tenant                      @relation(fields: [tenantId], references: [id])
  history       SubscriptionHistory[]
  modules       SubscriptionFeatureModule[]

  @@index([pendingPlanId])
}

model FeatureModule {
  id                String                      @id @default(cuid())
  key               String                      @unique
  name              String
  description       String?
  monthlyPriceCents Int                         @default(0)
  isActive          Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  plans             PlanFeatureModule[]
  subscriptions     SubscriptionFeatureModule[]

  @@index([isActive, name])
}

model PlanFeatureModule {
  planId        String
  moduleId      String
  createdAt     DateTime      @default(now())
  plan          Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureModule FeatureModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([planId, moduleId])
  @@index([moduleId])
}

enum SubscriptionFeatureModuleStatus {
  ACTIVE
  PENDING_ADD
  PENDING_REMOVE
}

model SubscriptionFeatureModule {
  id             String                          @id @default(cuid())
  subscriptionId String
  tenantId       String
  moduleId       String
  status         SubscriptionFeatureModuleStatus @default(ACTIVE)
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  subscription   Subscription                    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant         Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureModule  FeatureModule                   @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, moduleId])
  @@index([tenantId, status])
}

model SubscriptionHistory {
  id                      String            @id @default(cuid())
  subscriptionId          String
  tenantId                String
  eventType               String
  actorUserId             String?
  actorPlatformIdentityId String?
  actorType               String            @default("SYSTEM")
  metadata                Json
  createdAt               DateTime          @default(now())
  subscription            Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorPlatformIdentity   PlatformIdentity? @relation(fields: [actorPlatformIdentityId], references: [id], onDelete: Restrict)

  @@index([tenantId, subscriptionId, createdAt, id])
  @@index([actorPlatformIdentityId, createdAt])
}

model SubscriptionMonthlyUsage {
  id                  String   @id @default(cuid())
  tenantId            String
  periodKey           String
  orderCount          Int      @default(0)
  overLimitOrderCount Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodKey])
}

model Invoice {
  id                          String                       @id @default(cuid())
  tenantId                    String
  subscriptionId              String?
  invoiceNumber               String                       @unique
  amountCents                 Int
  refundedAmountCents         Int                          @default(0)
  currency                    String                       @default("IDR")
  status                      String                       @default("PENDING")
  providerReferenceId         String?                      @unique
  providerPaymentRequestId    String?                      @unique
  providerPaymentId           String?                      @unique
  providerEventId             String?                      @unique
  providerStatus              String?
  billingPeriodKey            String?                      @unique
  dueAt                       DateTime?
  paidAt                      DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  deletedAt                   DateTime?
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  xenditPaymentRequestAttempt XenditPaymentRequestAttempt?
  refunds                     InvoiceRefund[]
  autopayAttempts             AutopayChargeAttempt[]
  autopayPaymentMethods       AutopayPaymentMethod[]

  @@index([tenantId])
}

model InvoiceNumberCounter {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

model XenditPaymentRequestAttempt {
  id                       String                           @id @default(cuid())
  invoiceId                String                           @unique
  tenantId                 String
  state                    XenditPaymentRequestAttemptState @default(IN_PROGRESS)
  providerPaymentRequestId String?                          @unique
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  invoice                  Invoice                          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
}

model XenditWebhookReceipt {
  id               String    @id @default(cuid())
  idempotencyKey   String    @unique @db.VarChar(64)
  paymentRequestId String?
  paymentId        String
  referenceId      String?
  eventType        String
  paymentStatus    String
  outcome          String    @default("PROCESSING")
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@index([paymentRequestId])
  @@index([paymentId])
}

model InvoiceRefund {
  id               String    @id @default(cuid())
  tenantId         String
  invoiceId        String
  referenceId      String    @unique
  providerRefundId String?   @unique
  amountCents      Int
  currency         String    @db.Char(3)
  reason           String
  status           String    @default("PENDING")
  providerStatus   String?
  actorType        String
  actorId          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  processedAt      DateTime?
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId, createdAt])
  @@index([tenantId, status])
}

model AutopayPaymentMethod {
  id                               String    @id @default(cuid())
  tenantId                         String
  invoiceId                        String?
  referenceId                      String    @unique
  providerPaymentRequestId         String?   @unique
  providerPaymentSessionId         String?   @unique
  providerPaymentTokenIdCiphertext String?
  encryptionIv                     String?
  encryptionAuthTag                String?
  encryptionKeyVersion             String?
  tokenFingerprint                 String?
  channelCode                      String
  currency                         String    @db.Char(3)
  status                           String    @default("PENDING")
  consentAt                        DateTime
  consentVersion                   String
  consentUserId                    String
  revokedAt                        DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  tenant                           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice                          Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([invoiceId])
}

model AutopayChargeAttempt {
  id                       String    @id @default(cuid())
  tenantId                 String
  invoiceId                String
  attemptNumber            Int
  referenceId              String    @unique
  providerPaymentRequestId String?   @unique
  providerPaymentId        String?   @unique
  status                   String    @default("IN_PROGRESS")
  nextAttemptAt            DateTime?
  errorCategory            String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  processedAt              DateTime?
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice                  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, attemptNumber])
  @@index([tenantId, status, nextAttemptAt])
  @@index([invoiceId, status])
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
}

model UserOutlet {
  id        String    @id @default(cuid())
  userId    String
  outletId  String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([tenantId])
}

